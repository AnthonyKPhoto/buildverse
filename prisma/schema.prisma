generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./buildverse.db"
}

model Vehicle {
  id           String   @id @default(cuid())
  name         String?
  year         Int
  make         String
  model        String
  trim         String?
  engine       String?
  transmission String?
  drivetrain   String?
  vin          String?
  mileage      Int?
  platform     String?
  color        String?
  photoUrl     String?
  notes        String?
  instagramUrl String?
  facebookUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modifications   Modification[]
  maintenanceLogs MaintenanceLog[]
  budgets         Budget[]
  files           VehicleFile[]
  dynoRuns        DynoRun[]
  tuneLogs        TuneLog[]
  links           VehicleLink[]
  vehicleNotes    VehicleNote[]
}

model VehicleLink {
  id          String   @id @default(cuid())
  vehicleId   String
  title       String
  url         String
  description String?
  category    String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Modification {
  id             String    @id @default(cuid())
  vehicleId      String
  name           String
  category       String
  vendor         String?
  brand          String?
  price          Float?
  actualPrice    Float?
  notes          String?
  priority       String    @default("NONE")
  status         String    @default("PLANNED")
  link           String?
  imageUrl       String?
  difficulty     String?
  installDate    DateTime?
  installMileage Int?
  laborCost      Float?
  diyInstall     Boolean   @default(false)
  orderNumber    String?
  partNumber     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dependencies ModDependency[] @relation("ModDependencies")
  dependents   ModDependency[] @relation("ModDependents")
}

model ModDependency {
  id          String @id @default(cuid())
  modId       String
  dependsOnId String

  mod       Modification @relation("ModDependencies", fields: [modId], references: [id], onDelete: Cascade)
  dependsOn Modification @relation("ModDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([modId, dependsOnId])
}

model TrackedProduct {
  id           String    @id @default(cuid())
  url          String    @unique
  title        String
  brand        String?
  imageUrl     String?
  description  String?
  currentPrice    Float?
  lowestPrice     Float?
  highestPrice    Float?
  alertThreshold  Float?
  lastChecked     DateTime?
  vendor          String?
  availability    String?
  sku             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  priceHistory PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Float
  createdAt DateTime @default(now())

  product TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  vehicleId String
  category  String
  planned   Float    @default(0)
  actual    Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, category])
}

model MaintenanceLog {
  id        String    @id @default(cuid())
  vehicleId String
  service   String
  mileage   Int?
  date      DateTime
  cost      Float?
  notes     String?
  shop      String?
  diy       Boolean   @default(false)
  nextDue    DateTime?
  nextMiles  Int?
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([externalId])
}

model DynoRun {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime
  hp        Float?
  torque    Float?
  label     String?
  notes     String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleFile {
  id           String   @id
  vehicleId    String
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model TuneLog {
  id           String   @id @default(cuid())
  vehicleId    String
  name         String
  filename     String
  originalName String
  size         Int
  uploadedAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Receipt {
  id          String   @id @default(cuid())
  vendor      String?
  orderNumber String?
  totalAmount Float?
  date        DateTime?
  rawText     String?
  imageUrl    String?
  items       String?
  createdAt   DateTime @default(now())
}

model VehicleNote {
  id        String   @id @default(cuid())
  vehicleId String
  title     String   @default("")
  content   String   @default("")
  color     String   @default("yellow")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Setting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}
