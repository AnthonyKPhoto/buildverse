generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String?
  year            Int
  make            String
  model           String
  trim            String?
  engine          String?
  transmission    String?
  drivetrain      String?
  vin             String?
  mileage         Int?
  platform        String?
  color           String?
  photoUrl        String?
  notes           String?
  instagramUrl    String?
  facebookUrl     String?
  createdByUserId String?  // server mode only — null in local/Electron use
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  modifications   Modification[]
  maintenanceLogs MaintenanceLog[]
  budgets         Budget[]
  files           VehicleFile[]
  dynoRuns        DynoRun[]
  tuneLogs        TuneLog[]
  links           VehicleLink[]
  vehicleNotes    VehicleNote[]
  accessGrants    VehicleAccess[]

  @@index([createdByUserId])
}

model VehicleLink {
  id          String   @id @default(cuid())
  vehicleId   String
  title       String
  url         String
  description String?
  category    String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Modification {
  id             String    @id @default(cuid())
  vehicleId      String
  name           String
  category       String
  vendor         String?
  brand          String?
  price          Float?
  actualPrice    Float?
  notes          String?
  priority       String    @default("NONE")
  status         String    @default("PLANNED")
  link           String?
  imageUrl       String?
  difficulty     String?
  installDate    DateTime?
  installMileage Int?
  laborCost      Float?
  diyInstall     Boolean   @default(false)
  orderNumber    String?
  partNumber     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dependencies ModDependency[] @relation("ModDependencies")
  dependents   ModDependency[] @relation("ModDependents")
}

model ModDependency {
  id          String @id @default(cuid())
  modId       String
  dependsOnId String

  mod       Modification @relation("ModDependencies", fields: [modId], references: [id], onDelete: Cascade)
  dependsOn Modification @relation("ModDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([modId, dependsOnId])
}

model TrackedProduct {
  id           String    @id @default(cuid())
  url          String    @unique
  title        String
  brand        String?
  imageUrl     String?
  description  String?
  currentPrice    Float?
  lowestPrice     Float?
  highestPrice    Float?
  alertThreshold  Float?
  lastChecked     DateTime?
  vendor          String?
  availability    String?
  sku             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  priceHistory PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Float
  createdAt DateTime @default(now())

  product TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  vehicleId String
  category  String
  planned   Float    @default(0)
  actual    Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, category])
}

model MaintenanceLog {
  id        String    @id @default(cuid())
  vehicleId String
  service   String
  mileage   Int?
  date      DateTime
  cost      Float?
  notes     String?
  shop      String?
  diy       Boolean   @default(false)
  nextDue    DateTime?
  nextMiles  Int?
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([externalId])
}

model DynoRun {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime
  hp        Float?
  torque    Float?
  label     String?
  notes     String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleFile {
  id           String   @id
  vehicleId    String
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model TuneLog {
  id           String   @id @default(cuid())
  vehicleId    String
  name         String
  filename     String
  originalName String
  size         Int
  uploadedAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Receipt {
  id          String   @id @default(cuid())
  vendor      String?
  orderNumber String?
  totalAmount Float?
  date        DateTime?
  rawText     String?
  imageUrl    String?
  items       String?
  createdAt   DateTime @default(now())
}

// Build log — a chronological timeline of entries about a vehicle's build
// (v1.11.0 reworked this from a sticky-note board into a dated log; color/
// importance are the old note-board fields, kept only so existing data is
// never lost — the current UI reads entryDate/mileage/pinned instead).
model VehicleNote {
  id         String   @id @default(cuid())
  vehicleId  String
  title      String   @default("")
  content    String   @default("")
  color      String   @default("yellow") // legacy — no longer shown in the UI
  importance Int      @default(0)        // legacy — superseded by `pinned`
  entryDate  DateTime @default(now())    // when the entry is "about", editable, distinct from createdAt
  mileage    Int?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Setting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}

// Server deployments only (see src/lib/auth) — inert/unused in local/Electron
// mode. Everyone shares the same garage data for *viewing*; edit access to a
// given vehicle is admins + its creator + explicit VehicleAccess grants.
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String?  // used to send a temp password when an admin creates the account
  passwordHash       String
  role               String   @default("member") // "admin" | "member"
  mustChangePassword Boolean  @default(false) // true after an admin creates the account with a temp password
  // Per-user appearance — each user's own look, editable only by themselves.
  accentColor        String?
  radius             String?
  font               String?
  colorScheme        String?
  createdAt          DateTime @default(now())

  createdVehicles Vehicle[]
  vehicleAccess   VehicleAccess[]
  resetTokens     PasswordResetToken[]
}

// Self-service "forgot password" — a hash of the emailed token, never the raw
// token itself, so a database read alone can't be used to take over an
// account. One-time use (usedAt) and short-lived (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Explicit "this user may edit this vehicle" grant, set by an admin. Does not
// affect viewing — the garage stays shared for everyone to look at.
model VehicleAccess {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, userId])
}
