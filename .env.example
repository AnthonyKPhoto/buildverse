# SQLite database path. For local dev, a relative path is fine.
# For Docker, this should point at a file on a mounted volume, e.g. file:/data/buildverse.db
DATABASE_URL="file:./dev.db"

# ── Server-only (Docker) — leave all three unset for local/Electron use,
#    which then runs with zero auth friction exactly as it does today. ────
#
# Bootstrap admin account, created automatically on first boot. Everyone
# else (including additional admins) is created later from Settings → Users
# by an admin — these two vars only matter for this very first account.
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.js "your-password"
ADMIN_PASSWORD_HASH=

# Any long random string, used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
