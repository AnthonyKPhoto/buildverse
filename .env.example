# Copy this file to .env — used for local dev directly, AND for Docker: if
# you place a copy of it (as .env) in the same directory as docker-compose.yml,
# `docker compose` loads it automatically for the ${VAR} references in that
# file. No other setup needed — don't edit docker-compose.yml itself.

# SQLite database path. For local dev, a relative path is fine. Docker ignores
# this one — docker-compose.yml hardcodes the container's own volume path.
DATABASE_URL="file:./dev.db"

# ── Server-only (Docker) — leave both unset for local/Electron use, which
#    then runs with zero auth friction exactly as it does today. ──────────
#
# Any long random string, used to sign session cookies. Setting this alone
# turns on server mode (login required for anyone outside the container's
# own loopback). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Optional. If left unset, the first person to visit the site gets a
# "create the admin account" form instead of a login form, and that account
# becomes admin — simplest for a fresh deployment. Set these two only if you
# want a specific admin account pre-provisioned before anyone visits the site.
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.js "your-password"
ADMIN_PASSWORD_HASH=
